# NyaaV3 Docker Environment Variables
# Copy this file to .env and modify as needed

# Database configuration
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=nyaav3
DB_USER=nyaauser
DB_PASSWORD=nyaapass
MYSQL_ROOT_PASSWORD=rootpass

# Elasticsearch configuration (use COMPOSE_PROFILES=es to enable)
ES_HOSTS=http://elasticsearch:9200
ES_INDEX_NAME=nyaa
USE_ELASTIC_SEARCH=false
USE_BAKED_SEARCH=false
ENABLE_ELASTIC_SEARCH_HIGHLIGHT=false
ES_MAX_SEARCH_RESULT=1000
ES_RUN_IMPORT=false

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# Application configuration
SITE_FLAVOR=nyaa
SITE_NAME=Nyaa
GLOBAL_SITE_NAME=Nyaa.si
DEBUG=false

# Security
SECRET_KEY=changeme_in_production
CSRF_SESSION_KEY=changeme_in_production

# Email configuration (optional)
MAIL_BACKEND=smtp
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=Sender Name <sender@domain.com>

# Features
USE_RECAPTCHA=false
RECAPTCHA_PUBLIC_KEY=***
RECAPTCHA_PRIVATE_KEY=***
USE_EMAIL_VERIFICATION=false
ENABLE_GRAVATAR=true
ALLOW_PASSWORD_RESET=true

# Cache configuration
CACHE_TYPE=redis
CACHE_THRESHOLD=8192

# Flask-Assets / Webassets (keep caches out of the bind-mounted repo)
NYAA_STATIC_FOLDER=/app/state/static
ASSETS_CACHE=/app/state/webassets-cache

# Rate limiting
RATELIMIT_UPLOADS=true
MAX_UPLOAD_BURST=5
UPLOAD_BURST_DURATION=2700
UPLOAD_TIMEOUT=900

# Maintenance
MAINTENANCE_MODE=false
RAID_MODE_LIMIT_UPLOADS=false
RAID_MODE_LIMIT_REGISTER=false

# Binlog sync
ENABLE_BINLOG_SYNC=true

# NOTE: For the optional sync_es service, the MariaDB user needs binlog/replication permissions.
# This repo mounts an init script into MariaDB at `.docker/configs/mariadb-init/01-binlog-permissions.sh`.
# That script runs only when the DB volume is created for the first time.

# Init behavior
# - First start initializes DB/ES and writes a marker into STATE_DIR.
# - Set FORCE_INIT=true to re-run init.
STATE_DIR=/app/state
FORCE_INIT=false
APP_USER=appuser

# Unified writable dirs (avoid writing into bind-mounted /app)
DATA_DIR=/app/state
INFO_DICTS_DIR=/app/state/info_dicts
TORRENTS_DIR=/app/torrents
LOG_DIR=/app/logs

# sync_es tuning (if enabled)
SYNC_ES_CONFIG=/app/state/es_sync_config.json
SYNC_ES_SAVE_LOC=/app/state/es_sync_position.json
SYNC_ES_INTERNAL_QUEUE_DEPTH=10000
SYNC_ES_CHUNK_SIZE=10000
SYNC_ES_FLUSH_INTERVAL=5
